# Copy to .env and fill in secrets. Never commit real keys.
# Channel interface: channels.json
#   1 aijws     -> CHANNEL_AIJWS_KEY
#   2 original  -> CHANNEL_ORIGINAL_KEY / GROK_API_KEY
#   3 suixiang  -> CHANNEL_SUIXIANG_KEY

CHANNEL_AIJWS_KEY=
CHANNEL_ORIGINAL_KEY=
CHANNEL_SUIXIANG_KEY=

# legacy alias for original channel
GROK_API_BASE=https://ai.0xs.one/v1
GROK_API_KEY=
GROK_MODEL=grok-4.5
GROK_FALLBACK_MODELS=
GROK_TIMEOUT_SECONDS=180
X_SEARCH_TRANSIENT_RETRIES=1

# Optional temporary reorder without editing channels.json:
# X_SEARCH_PRIORITY=suixiang,aijws,original
