{
  "skill_name": "genius-cpa-image",
  "evals": [
    {
      "id": "trigger-gpt-image-2",
      "prompt": "用 CPA 的 gpt-image-2 生成一个红色方块图标",
      "trigger_expected": true,
      "expected_output": "Uses genius-cpa-image with gpt-image-2 on US CPA images API",
      "files": ["scripts/cpa_image.py"],
      "assertions": [
        {"type": "contains", "value": "gpt-image-2"}
      ]
    },
    {
      "id": "trigger-cpa-name",
      "prompt": "Genius_Cpa_image 帮我生图",
      "trigger_expected": true,
      "expected_output": "Triggers genius-cpa-image and uses gpt-image-2",
      "files": ["SKILL.md"],
      "assertions": [
        {"type": "contains", "value": "gpt-image-2"}
      ]
    },
    {
      "id": "trigger-codex-image",
      "prompt": "US CPA Codex 生图",
      "trigger_expected": true,
      "expected_output": "gpt-image-2 via cpa-us",
      "files": ["scripts/cpa_image.py"],
      "assertions": [
        {"type": "contains", "value": "cpa-us"}
      ]
    },
    {
      "id": "ref-edit",
      "prompt": "基于这张参考图，用 CPA 改成侧身站立",
      "trigger_expected": true,
      "expected_output": "cpa_image.py with --ref on gpt-image-2 edits",
      "files": ["scripts/cpa_image.py"],
      "assertions": [
        {"type": "contains", "value": "--ref"}
      ]
    },
    {
      "id": "gpt-image-4k-coerce",
      "prompt": "用 gpt-image-2 出一张 4K 16:9 风景图",
      "trigger_expected": true,
      "expected_output": "Uses gpt-image-2 but CPA-US is 1K-only: 16:9 → 1672x941; do not claim true 4K",
      "files": ["scripts/cpa_image.py"],
      "assertions": [
        {"type": "contains", "value": "1K"}
      ]
    },
    {
      "id": "no-trigger-gemini",
      "prompt": "用 JP CPA 的 gemini-3.1-flash-image 画一只窗边橘猫",
      "trigger_expected": false,
      "expected_output": "Gemini image path is retired. Do not call generateContent. If the user still wants CPA images, use gpt-image-2 and say 1K-only.",
      "files": ["SKILL.md"],
      "assertions": [
        {"type": "not_contains", "value": "generateContent"}
      ]
    },
    {
      "id": "no-trigger-crun-nano",
      "prompt": "用 nano-banana-2-lite 快速出一张草稿",
      "trigger_expected": false,
      "expected_output": "Crun/nano is not this skill",
      "files": ["SKILL.md"],
      "assertions": [
        {"type": "not_contains", "value": "gpt-image-2"}
      ]
    },
    {
      "id": "no-trigger-dreamina",
      "prompt": "用即梦 Seedream 生成海报",
      "trigger_expected": false,
      "expected_output": "Use dreamina-cli",
      "files": ["SKILL.md"],
      "assertions": [
        {"type": "contains", "value": "dreamina"}
      ]
    }
  ]
}
