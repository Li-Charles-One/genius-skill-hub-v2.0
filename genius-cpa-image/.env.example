# Copy to .env (or scripts/.env / Genius_cpa_image.env) and fill in secrets.
# Real .env files are gitignored (*.env) — never commit keys.

# --- JP CPA (Gemini generateContent / gemini-3.1-flash-image) ---
CPA_JP_API_KEY=
# CPA_API_KEY=          # optional alias for JP
# CPA_JP_BASE=https://cpa-jp.charles-ai.space

# --- US CPA (OpenAI images / gpt-image-2) ---
CPA_US_API_KEY=
# CPA_GPT_API_KEY=      # optional alias for US
# CPA_US_BASE=https://cpa.artistic-genius.vip

# --- Log / job rotation (optional) ---
# CPA_IMAGE_LOG_MAX_MB=10
# CPA_IMAGE_LOG_KEEP_DAYS=7
# CPA_IMAGE_LOG_MAX_ARCHIVES=20
# CPA_IMAGE_JOB_LOG_MAX_MB=5
# CPA_IMAGE_JOB_KEEP_DAYS=7
# CPA_IMAGE_JOB_MAX_FILES=100
