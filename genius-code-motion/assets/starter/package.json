{
  "name": "code-motion-project",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still Main out/check.png --frame=30",
    "draft": "remotion render Main out/draft.mp4 --scale=0.5 --props=props/draft.json",
    "render": "remotion render Main out/video.mp4 --crf=16",
    "render:nosub": "remotion render Main out/video-nosub.mp4 --crf=16 --props=props/nosub.json",
    "render:3d": "remotion render Main out/layer-3d.mp4 --crf=16 --props=props/3d.json",
    "render:hud": "remotion render Main out/layer-hud.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le --props=props/hud.json"
  }
}
